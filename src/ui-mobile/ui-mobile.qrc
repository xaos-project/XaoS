<RCC>
    <qresource prefix="/">
        <file alias="qml/qmldir">qml/qmldir</file>
        <file alias="qml/Theme.qml">qml/Theme.qml</file>
        <file alias="qml/main.qml">qml/main.qml</file>

        <file alias="qml/ScreenHeader.qml">qml/ScreenHeader.qml</file>
        <file alias="qml/SectionLabel.qml">qml/SectionLabel.qml</file>
        <file alias="qml/IconBadge.qml">qml/IconBadge.qml</file>
        <file alias="qml/SettingsCard.qml">qml/SettingsCard.qml</file>
        <file alias="qml/StyledSlider.qml">qml/StyledSlider.qml</file>
        <file alias="qml/ThemedSpinBox.qml">qml/ThemedSpinBox.qml</file>
        <file alias="qml/ThemedPopup.qml">qml/ThemedPopup.qml</file>
        <file alias="qml/ThemedField.qml">qml/ThemedField.qml</file>
        <file alias="qml/PrimaryButton.qml">qml/PrimaryButton.qml</file>
        <file alias="qml/GhostButton.qml">qml/GhostButton.qml</file>
        <file alias="qml/SegmentedControl.qml">qml/SegmentedControl.qml</file>
        <file alias="qml/EmptyState.qml">qml/EmptyState.qml</file>
